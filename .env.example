# Timezone (오후 7시 질문 생성 / 오후 5시 자동 공개 기준)
TZ=Asia/Seoul

# PostgreSQL 16 (호스트 포트 15432 -> 컨테이너 5432: 타 프로젝트 충돌 방지)
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=ieum_local
POSTGRES_USER=ieum_user
POSTGRES_PASSWORD=ieum_pass_local

# Redis 7 (호스트 포트 16379 -> 컨테이너 6379: 타 프로젝트 충돌 방지)
REDIS_HOST=localhost
REDIS_PORT=16379

# LocalStack S3 (Local AWS S3 Emulator)
S3_PORT=4566
S3_ENDPOINT=http://localhost:4566
S3_REGION=ap-northeast-2
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_BUCKET_NAME=ieum-voice-storage-local
S3_EPHEMERAL_PREFIX=audio/ephemeral-30d/
S3_PERMANENT_PREFIX=audio/permanent/

# 인증 (JWT_SECRET은 32바이트 이상의 임의 문자열을 직접 생성해 .env에만 넣는다. 실제 값 커밋 금지)
JWT_SECRET=
KAKAO_APP_ID=
APPLE_CLIENT_ID=
